
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[300], cipher[300], plain[300];
    int K[2][2] = {{9,4},{5,7}};
    int inv[2][2] = {{5,12},{15,25}};
    int i, n = 0, a, b, x, y;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i]; i++)
        if (isalpha((unsigned char)text[i]))
            text[n++] = toupper((unsigned char)text[i]);

    if (n % 2) text[n++] = 'X';

    for (i = 0; i < n; i += 2)
    {
        a = text[i] - 'A';
        b = text[i+1] - 'A';

        cipher[i]   = (K[0][0]*a + K[0][1]*b) % 26 + 'A';
        cipher[i+1] = (K[1][0]*a + K[1][1]*b) % 26 + 'A';
    }
    cipher[n] = '\0';

    printf("Ciphertext: %s\n", cipher);
    printf("Decrypted : ");

    for (i = 0; i < n; i += 2)
    {
        a = cipher[i] - 'A';
        b = cipher[i+1] - 'A';

        x = (inv[0][0]*a + inv[0][1]*b) % 26;
        y = (inv[1][0]*a + inv[1][1]*b) % 26;

        plain[i] = x + 'A';
        plain[i+1] = y + 'A';
    }

    plain[n] = '\0';
    printf("%s\n", plain);
    return 0;
}
