
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[500], key[100];
    int i, j = 0, shift;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key: ");
    scanf("%99s", key);

    printf("Ciphertext: ");

    for (i = 0; text[i] != '\0'; i++) {
        char c = text[i];

        if (isalpha((unsigned char)c)) {
            shift = toupper((unsigned char)key[j % strlen(key)]) - 'A';

            if (isupper((unsigned char)c))
                printf("%c", (c - 'A' + shift) % 26 + 'A');
            else
                printf("%c", (c - 'a' + shift) % 26 + 'a');

            j++;
        } else {
            printf("%c", c);
        }
    }

    printf("\n");
    return 0;
}
