
#include <stdio.h>
#include <string.h>
#include <ctype.h>

char m[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void encrypt(char a, char b)
{
    int r1, c1, r2, c2, i, j;

    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
        {
            if (m[i][j] == a) r1=i, c1=j;
            if (m[i][j] == b) r2=i, c2=j;
        }

    if (r1 == r2)
        printf("%c%c", m[r1][(c1+1)%5],
                        m[r2][(c2+1)%5]);
    else if (c1 == c2)
        printf("%c%c", m[(r1+1)%5][c1],
                        m[(r2+1)%5][c2]);
    else
        printf("%c%c", m[r1][c2], m[r2][c1]);
}

int main()
{
    char input[] =
    "Must see you over Cadogan West. Coming at once.";
    char p[200];
    int i, n = 0;

    for (i = 0; input[i]; i++)
        if (isalpha((unsigned char)input[i]))
        {
            char c = toupper((unsigned char)input[i]);
            if (c == 'J') c = 'I';
            p[n++] = c;
        }

    for (i = 0; i < n; i += 2)
    {
        char a = p[i];
        char b;

        if (i + 1 >= n)
            b = 'X';
        else
            b = p[i+1];

        if (a == b)
        {
            b = 'X';
            i--;
        }

        encrypt(a, b);
    }

    printf("\n");
    return 0;
}
