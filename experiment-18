
#include <stdio.h>
#include <stdint.h>

int main()
{
    int PC1[56] = {
        57,49,41,33,25,17,9,1,58,50,42,34,26,18,
        10,2,59,51,43,35,27,19,11,3,60,52,44,36,
        63,55,47,39,31,23,15,7,62,54,46,38,30,22,
        14,6,61,53,45,37,29,21,13,5,28,20,12,4
    };

    int PC2[48] = {
        14,17,11,24,1,5,3,28,15,6,21,10,
        23,19,12,4,26,8,16,7,27,20,13,2,
        41,52,31,37,47,55,30,40,51,45,33,48,
        44,49,39,56,34,53,46,42,50,36,29,32
    };

    int shift[16] = {
        1,1,2,2,2,2,2,2,1,2,2,2,2,2,1,1
    };

    uint64_t key;
    int bits[56], C[28], D[28], CD[56];
    int i, j, round;

    printf("Enter 64-bit key in hexadecimal: ");
    scanf("%llx", (unsigned long long *)&key);

    for (i = 0; i < 56; i++)
        bits[i] = (key >> (64-PC1[i])) & 1;

    for (i = 0; i < 28; i++)
    {
        C[i] = bits[i];
        D[i] = bits[i+28];
    }

    for (round = 0; round < 16; round++)
    {
        for (j = 0; j < shift[round]; j++)
        {
            int temp = C[0];
            for (i = 0; i < 27; i++)
                C[i] = C[i+1];
            C[27] = temp;

            temp = D[0];
            for (i = 0; i < 27; i++)
                D[i] = D[i+1];
            D[27] = temp;
        }

        for (i = 0; i < 28; i++)
        {
            CD[i] = C[i];
            CD[i+28] = D[i];
        }

        printf("K%d: ", round+1);

        for (i = 0; i < 48; i++)
        {
            int bit = CD[PC2[i]-1];
            printf("%d", bit);
            if ((i+1) % 6 == 0) printf(" ");
        }

        printf("\n");
    }

    return 0;
}
