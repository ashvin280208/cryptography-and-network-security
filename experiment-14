
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char p[] = "send more money";
    int key[] = {9,0,1,7,23,15,21,14,11,11,2,8,9};
    char c[100];
    int i, n = 0;

    for (i = 0; p[i]; i++)
        if (isalpha((unsigned char)p[i]))
        {
            int x = tolower((unsigned char)p[i]) - 'a';
            c[n] = (x + key[n]) % 26 + 'A';
            n++;
        }

    c[n] = '\0';
    printf("Ciphertext: %s\n", c);

    printf("Key for CASHNOTNEEDED: ");
    {
        char target[] = "cashnotneeded";
        for (i = 0; i < n; i++)
        {
            int k = (c[i] - 'A' -
                     (target[i] - 'a') + 26) % 26;
            printf("%d ", k);
        }
    }

    printf("\n");
    return 0;
}
