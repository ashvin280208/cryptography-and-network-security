
#include <stdio.h>
#include <string.h>
#include <ctype.h>

char mat[5][5];

void makeKey(char key[])
{
    int used[26] = {0}, k = 0, i, j;
    char s[26];

    used['J' - 'A'] = 1;

    for (i = 0; key[i]; i++)
    {
        char c = toupper((unsigned char)key[i]);
        if (c == 'J') c = 'I';

        if (c >= 'A' && c <= 'Z' && !used[c-'A'])
        {
            s[k++] = c;
            used[c-'A'] = 1;
        }
    }

    for (i = 0; i < 26; i++)
        if (!used[i]) s[k++] = 'A' + i;

    k = 0;
    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
            mat[i][j] = s[k++];
}

void decrypt(char a, char b)
{
    int r1, c1, r2, c2, i, j;

    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
        {
            if (mat[i][j] == a) r1 = i, c1 = j;
            if (mat[i][j] == b) r2 = i, c2 = j;
        }

    if (r1 == r2)
        printf("%c%c", mat[r1][(c1+4)%5],
                        mat[r2][(c2+4)%5]);
    else if (c1 == c2)
        printf("%c%c", mat[(r1+4)%5][c1],
                        mat[(r2+4)%5][c2]);
    else
        printf("%c%c", mat[r1][c2], mat[r2][c1]);
}

int main()
{
    char key[100];
    char text[] =
    "KXJEYUREBEZWEHEWRYTUHEYFS"
    "KREHEGOYFIWTTTUOLKSYCAJPO"
    "BOTEIZONTXBYBNTGONE YCUZWR"
    "GDSONSXBOUYWRHEBAAHYUSEDQ";
    char clean[200];
    int i, n = 0;

    printf("Enter Playfair keyword: ");
    fgets(key, sizeof(key), stdin);
    makeKey(key);

    for (i = 0; text[i]; i++)
        if (isalpha((unsigned char)text[i]))
        {
            char c = toupper((unsigned char)text[i]);
            if (c == 'J') c = 'I';
            clean[n++] = c;
        }

    if (n % 2 != 0)
    {
        printf("Invalid ciphertext length.\n");
        return 1;
    }

    printf("Decrypted text: ");
    for (i = 0; i < n; i += 2)
        decrypt(clean[i], clean[i+1]);

    printf("\n");
    return 0;
}
