
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char c[1000];
    double freq[26] = {
        8.17,1.49,2.78,4.25,12.70,2.23,2.02,
        6.09,6.97,0.15,0.77,4.03,2.41,6.75,
        7.51,1.93,0.10,5.99,6.33,9.06,2.76,
        0.98,2.36,0.15,1.97,0.07
    };
    int top, shift, i, j, count[26];
    double score;

    printf("Enter ciphertext: ");
    fgets(c, sizeof(c), stdin);

    printf("How many results? ");
    scanf("%d", &top);
    if (top < 1) return 0;
    if (top > 26) top = 26;

    for (int rank = 0; rank < top; rank++)
    {
        double best = -1e9;
        int bestShift = 0;

        for (shift = 0; shift < 26; shift++)
        {
            memset(count, 0, sizeof(count));
            int n = 0;

            for (i = 0; c[i]; i++)
                if (isalpha((unsigned char)c[i]))
                {
                    j = (toupper((unsigned char)c[i])
                         - 'A' - shift + 26) % 26;
                    count[j]++;
                    n++;
                }

            score = 0;
            for (i = 0; i < 26; i++)
                score += count[i] * freq[i];

            /* Avoid choosing the same shift twice */
            int used = 0;
            for (i = 0; i < rank; i++)
            {
                /* Recomputed below using stored shifts */
            }

            static int tried[26];
            if (rank == 0)
                memset(tried, 0, sizeof(tried));

            if (!tried[shift] && score > best)
            {
                best = score;
                bestShift = shift;
            }
        }

        static int tried[26];
        if (rank == 0)
            memset(tried, 0, sizeof(tried));
        tried[bestShift] = 1;

        printf("\nShift %d: ", bestShift);
        for (i = 0; c[i]; i++)
        {
            if (isalpha((unsigned char)c[i]))
            {
                char ch = isupper((unsigned char)c[i])
                    ? 'A' : 'a';
                putchar((c[i] - ch - bestShift + 26) % 26 + ch);
            }
            else putchar(c[i]);
        }
        printf("\n");
    }

    return 0;
}
