
#include <stdio.h>

int main()
{
    int P[2][2], C[2][2], inv[2][2];
    int det, d, i, j, k, K[2][2];

    printf("Enter plaintext matrix (4 numbers): ");
    scanf("%d%d%d%d", &P[0][0], &P[0][1],
                       &P[1][0], &P[1][1]);

    printf("Enter ciphertext matrix (4 numbers): ");
    scanf("%d%d%d%d", &C[0][0], &C[0][1],
                       &C[1][0], &C[1][1]);

    det = (P[0][0]*P[1][1] - P[0][1]*P[1][0]) % 26;
    if (det < 0) det += 26;

    for (d = 1; d < 26; d++)
        if ((det*d) % 26 == 1) break;

    if (d == 26)
    {
        printf("Plaintext matrix is not invertible.\n");
        return 1;
    }

    inv[0][0] = P[1][1]*d % 26;
    inv[0][1] = (26-P[0][1])*d % 26;
    inv[1][0] = (26-P[1][0])*d % 26;
    inv[1][1] = P[0][0]*d % 26;

    for (i = 0; i < 2; i++)
        for (j = 0; j < 2; j++)
        {
            K[i][j] = 0;
            for (k = 0; k < 2; k++)
                K[i][j] += C[i][k]*inv[k][j];

            K[i][j] %= 26;
        }

    printf("Recovered key matrix:\n");
    for (i = 0; i < 2; i++)
        printf("%d %d\n", K[i][0], K[i][1]);

    return 0;
}
