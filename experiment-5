
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main() {
    char text[500];
    int a, b, i;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    if (gcd(a, 26) != 1) {
        printf("Invalid a. Choose a coprime to 26.\n");
        return 0;
    }

    b = ((b % 26) + 26) % 26;

    printf("Ciphertext: ");

    for (i = 0; text[i] != '\0'; i++) {
        char c = text[i];

        if (isupper((unsigned char)c))
            printf("%c", ((a * (c - 'A') + b) % 26) + 'A');
        else if (islower((unsigned char)c))
            printf("%c", ((a * (c - 'a') + b) % 26) + 'a');
        else
            printf("%c", c);
    }

    printf("\n");
    return 0;
}
