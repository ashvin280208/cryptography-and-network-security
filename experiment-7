
#include <stdio.h>

int main() {
    char text[2000];
    int freq[256] = {0};
    int i;

    printf("Enter ciphertext:\n");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i] != '\0'; i++) {
        unsigned char c = (unsigned char)text[i];
        if (c != ' ' && c != '\n')
            freq[c]++;
    }

    printf("\nSymbol frequencies:\n");

    for (i = 0; i < 256; i++) {
        if (freq[i] > 0) {
            if (i >= 32 && i <= 126)
                printf("Symbol '%c' : %d\n", i, freq[i]);
            else
                printf("Symbol ASCII %d : %d\n", i, freq[i]);
        }
    }

    return 0;
}
