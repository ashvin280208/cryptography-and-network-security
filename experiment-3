
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char key[100], text[500], matrix[5][5];
    int used[26] = {0}, i, j, k = 0;
    char a, b;

    printf("Enter keyword: ");
    scanf("%99s", key);

    printf("Enter plaintext (no spaces): ");
    scanf("%499s", text);

    used['J' - 'A'] = 1;

    for (i = 0; key[i]; i++) {
        char c = toupper((unsigned char)key[i]);
        if (c == 'J') c = 'I';

        if (c >= 'A' && c <= 'Z' && !used[c - 'A']) {
            matrix[k / 5][k % 5] = c;
            used[c - 'A'] = 1;
            k++;
        }
    }

    for (i = 0; i < 26; i++) {
        if (!used[i]) {
            matrix[k / 5][k % 5] = 'A' + i;
            k++;
        }
    }

    printf("\nPlayfair Matrix:\n");
    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    char p[1000];
    int n = 0;

    for (i = 0; text[i]; i++) {
        char c = toupper((unsigned char)text[i]);
        if (c < 'A' || c > 'Z') continue;
        if (c == 'J') c = 'I';

        if (n > 0 && p[n - 1] == c) {
            p[n++] = 'X';
        }
        p[n++] = c;
    }

    if (n % 2 != 0) p[n++] = 'X';
    p[n] = '\0';

    printf("\nCiphertext: ");

    for (i = 0; i < n; i += 2) {
        int r1 = 0, c1 = 0, r2 = 0, c2 = 0;

        a = p[i];
        b = p[i + 1];

        for (j = 0; j < 25; j++) {
            if (matrix[j / 5][j % 5] == a) {
                r1 = j / 5; c1 = j % 5;
            }
            if (matrix[j / 5][j % 5] == b) {
                r2 = j / 5; c2 = j % 5;
            }
        }

        if (r1 == r2) {
            a = matrix[r1][(c1 + 1) % 5];
            b = matrix[r2][(c2 + 1) % 5];
        } else if (c1 == c2) {
            a = matrix[(r1 + 1) % 5][c1];
            b = matrix[(r2 + 1) % 5][c2];
        } else {
            a = matrix[r1][c2];
            b = matrix[r2][c1];
        }

        printf("%c%c", a, b);
    }

    printf("\n");
    return 0;
}
